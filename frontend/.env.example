# Falcon API base URL used by the dashboard.
# Leave empty (or unset) to call the API on the same origin (works with the
# Vite dev proxy /api -> http://localhost:8000, or when a static host proxies
# /api to the Falcon server).
# Defaults to http://localhost:8000 when unset.
VITE_API_BASE_URL=http://localhost:8000
